@model List<AjaxPhase04.Models.Student>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet"
      href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css" />

<h2>Add Student</h2>

<form id="StudentForm">
   

    <input type="text" name="Name" placeholder="Enter Name" />
    <span id="nameError" style="color:red;"></span>
    <br /><br />

    <input type="text" name="Email" placeholder="Enter Email" />
    <span id="emailError" style="color:red;"></span>
    <br /><br />

    <select name="Department" id="departmentSelect" style="width:200px;">
        <option value="">Select Department</option>
        <option value="SE">SE</option>
        <option value="CS">CS</option>
        <option value="IT">IT</option>
        <option value="DS">DS</option>
    </select>
    <span id="departmentError" style="color:red;"></span>
    <br /><br />
    <br />

  

    <input type="text"
           id="joiningDate"
           name="JoiningDate"
           placeholder="Select Joining Date" />

    <br /><br />

    <input type="hidden" name="Id" id="studentId" />

    <span id="errorMsg" style="color:red;"></span>
    <br /><br />

    <button type="button" id="btnSave">Save Student</button>
</form>

<hr />
<select id="departmentFilter">
    <option value="">All Departments</option>
    <option value="SE">SE</option>
    <option value="CS">CS</option>
    <option value="IT">IT</option>
    <option value="DS">DS</option>
</select>
<input type="text"
       id="customSearch"
       placeholder="Search Student..."
       style="margin-bottom:10px;" />
<h2>Students List</h2>

<table id="studentTable" border="1" cellpadding="10">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="studentTableBody"></tbody>
</table>

