    $("#studentTableBody").on("click", ".delete-btn", function () {
        var id = $(this).data("id");
        deleteStudent(id);
    });

    $("#studentTableBody").on("click", ".view-btn", function () {
        var id = $(this).data("id");
        showStudent(id);
    });

    $("#studentTableBody").on("click", ".inline-edit-btn", function () {
        var row = $(this).closest("tr");

        var name = row.find(".name-cell").text();
        var email = row.find(".email-cell").text();
        var department = row.find(".department-cell").text();

        row.find(".name-cell").html('<input type="text" class="edit-name" value="' + name + '" />');
        row.find(".email-cell").html('<input type="text" class="edit-email" value="' + email + '" />');
        row.find(".department-cell").html('<input type="text" class="edit-department" value="' + department + '" />');

        $(this)
            .removeClass("inline-edit-btn")
            .addClass("inline-save-btn")
            .text("Save");
    });

    $("#studentTableBody").on("click", ".inline-save-btn", function () {
        var row = $(this).closest("tr");

        var studentData = {
            Id: row.data("id"),
            Name: row.find(".edit-name").val(),
            Email: row.find(".edit-email").val(),
            Department: row.find(".edit-department").val()
        };

        sendAjaxRequest(
            "/Student/UpdateStudent",
            "POST",
            studentData,
            function (response) {
                alert(response.message);
               // loadStudents();loadStudents();
        studentDataTable.ajax.reload();
            }
        );
    });

    function deleteStudent(id) {
    Swal.fire({
        title: "Are you sure?",
        text: "This student will be deleted.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, delete it",
        cancelButtonText: "Cancel"
    }).then(function (result) {
        if (result.isConfirmed) {
            sendAjaxRequest(
                "/Student/DeleteStudent",
                "POST",
                { id: id },
                function () {
                    Swal.fire({
                        icon: "success",
                        title: "Deleted",
                        text: "Student deleted successfully."
                    });

                   // loadStudents();
        studentDataTable.ajax.reload();
                }
            );
        }
    });
}

   function showStudent(id) {
    sendAjaxRequest(
        "/Student/GetStudentById",
        "GET",
        { id: id },
        function (response) {
            if (!response.success) {
                $("#errorMsg").text(response.message);
                return;
            }

            var student = response.student;

            $("#modalContent").html(
                "<b>Name:</b> " + student.name + "<br>" +
                "<b>Email:</b> " + student.email + "<br>" +
                "<b>Department:</b> " + student.department
            );

            var modal = new bootstrap.Modal(document.getElementById("studentModal"));
            modal.show();
        }
    );
}

   

    function clearForm() {
        $("#studentId").val("");
        $("input[name='Name']").val("");
        $("input[name='Email']").val("");
        $("#departmentSelect").val("").trigger("change");

        $("#nameError").text("");
        $("#emailError").text("");
        $("#departmentError").text("");
        $("#errorMsg").text("");
    }

    
