       // loadStudents();
        initializeServerSideDataTable();
        $("#customSearch").keyup(function () {

    clearTimeout(searchTimer);

    var value = $(this).val();

    searchTimer = setTimeout(function () {

        studentDataTable.search(value).draw();

    }, 500);

});
    });
   
    function disableFormControls() {
        $("#StudentForm input").prop("disabled", true);
        $("#btnSave").prop("disabled", true).text("Saving...");
     }

    function enableFormControls() {
       $("#StudentForm input").prop("disabled", false);
       $("#btnSave").prop("disabled", false).text("Save Student");
    }
    function validateStudentForm() {
        var isValid = true;

        var name = $("input[name='Name']").val().trim();
        var email = $("input[name='Email']").val().trim();
        var department = $("#departmentSelect").val();

        $("#nameError").text("");
        $("#emailError").text("");
        $("#departmentError").text("");

        var namePattern = /^[A-Za-z ]+$/;
        var emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

        if (name == "") {
            $("#nameError").text("Name is required");
            isValid = false;
        }
        else if (!namePattern.test(name)) {
            $("#nameError").text("Name can contain letters only");
            isValid = false;
        }

        if (email == "") {
            $("#emailError").text("Email is required");
            isValid = false;
        }
        else if (!emailPattern.test(email)) {
            $("#emailError").text("Invalid email format");
            isValid = false;
        }

        if (department == "") {
            $("#departmentError").text("Department is required");
            isValid = false;
        }

        return isValid;
    }

    function sendAjaxRequest(url, type, data, successCallback) {
        


        $.ajax({
            url: url,
            type: type,
            data: data,
           
            success: function (response) {
                successCallback(response);
            },

            error: function () {
                $("#errorMsg").text("Something went wrong");
            }
        });
    }

    $("#btnSave").click(function () {
        if (isSubmitting) {
            return;
        }

        $("#errorMsg").text("");

        if (!validateStudentForm()) {
            return;
        }

        var id = $("#studentId").val();
        var url = id == "" ? "/Student/AddStudent" : "/Student/UpdateStudent";
        var studentData = $("#StudentForm").serialize();

        isSubmitting = true;
        disableFormControls();
        $("#btnSave").prop("disabled", true).text("Saving...");
        
        $.ajax({
            url: url,
            type: "POST",
            data: studentData,
           

            success: function (response) {
                //alert(response.message);
                Swal.fire({
                    icon: "success",
                    title: "Success",
                    text: response.message
            });
                //loadStudents();
        studentDataTable.ajax.reload();
                clearForm();
            },

            error: function (xhr) {
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: "Something went wrong. Please try again."
                });
            },

            complete: function () {
                isSubmitting = false;
                enableFormControls();
                
            }
        });
    });
   function initializeServerSideDataTable() {
    studentDataTable = $("#studentTable").DataTable({
        processing: true,
        serverSide: true,
        dom: "Brtip",
       
        ajax: {

            url: "/Student/GetStudentsServerSide",
            type: "POST"
               
        },

        dom: "Bfrtip",

        buttons: [
            {
                extend: "copy",
                exportOptions: { columns: [0, 1, 2, 3] }
            },
            {
                extend: "csv",
                exportOptions: { columns: [0, 1, 2, 3] }
            },
            {
                extend: "excel",
                exportOptions: { columns: [0, 1, 2, 3] }
            },
            {
                extend: "pdf",
                exportOptions: { columns: [0, 1, 2, 3] }
            },
            {
                extend: "print",
                exportOptions: { columns: [0, 1, 2, 3] }
            }
        ],

        columns: [
    { data: "id" },

    {
        data: "name",
        render: function (data) {
            return '<span class="name-cell">' + data + '</span>';
        }
    },

    {
        data: "email",
        render: function (data) {
            return '<span class="email-cell">' + data + '</span>';
        }
    },

    {
        data: "department",
        render: function (data) {
            return '<span class="department-cell">' + data + '</span>';
        }
    },

    {
        data: "id",
        orderable: false,
        searchable: false,
        render: function (id) {
            return '<button type="button" class="view-btn" data-id="' + id + '">View</button> ' +
                   '<button type="button" class="inline-edit-btn" data-id="' + id + '">Edit Inline</button> ' +
                   '<button type="button" class="delete-btn" data-id="' + id + '">Delete</button>';
        }
    }
]
    });
}
     $("#departmentFilter").change(function () {
        var selectedDepartment = $(this).val();

         studentDataTable
